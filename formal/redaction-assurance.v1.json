{
  "$schema": "./redaction-assurance.schema.json",
  "schema": "ores-lib-core/redaction-assurance/v1",
  "subject": "credential-redaction",
  "criticality": "security",
  "properties": [
    "idempotence",
    "sensitive-value-noninterference",
    "safe-field-preservation",
    "normalization-closure",
    "secret-representation-opacity"
  ],
  "domain": {
    "sensitiveRoots": [
      "authorization",
      "cookie",
      "password",
      "secret",
      "token",
      "access_token",
      "refresh_token",
      "id_token",
      "client_secret",
      "private_key",
      "totp_seed",
      "webauthn_challenge",
      "face_image",
      "face_template",
      "fingerprint_image",
      "fingerprint_template",
      "biometric_template",
      "voiceprint"
    ],
    "safeFields": [
      "request_id",
      "trace_id",
      "message",
      "organization_id",
      "status_code"
    ],
    "prefixes": ["", "oauth_", "x-vendor-", "telemetry."]
  },
  "refinements": {
    "typescript": {
      "source": "langs/typescript/src/index.js",
      "check": "langs/typescript/test/formal_properties.test.js"
    },
    "rust": {
      "source": "langs/rust/src/lib.rs",
      "check": "langs/rust/tests/formal_properties.rs"
    },
    "dart": {
      "source": "langs/dart/lib/ores_lib_core.dart",
      "check": "langs/dart/tool/formal_check.dart"
    }
  }
}
