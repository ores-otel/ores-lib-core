{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from ores.schema-ir.v1. Root accepts any declared model; select a $defs entry to require a particular model. Cross-row SQL constraints are not JSON instance validation.",
  "anyOf": [
    {
      "$ref": "#/$defs/Member"
    },
    {
      "$ref": "#/$defs/MemberPatch"
    },
    {
      "$ref": "#/$defs/Organization"
    }
  ],
  "$defs": {
    "Member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "rank": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "required": [
        "displayName",
        "enabled",
        "id",
        "organizationId",
        "rank"
      ]
    },
    "MemberPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "Organization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  }
}
